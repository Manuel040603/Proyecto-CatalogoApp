@OptIn(ExperimentalMaterial3Api::class)
@Composable
fun DevolucionScreen(
    viewModel: DevolucionViewModel,
    onVolver: () -> Unit
) {
    val estado by viewModel.uiState.collectAsState()
    val context = androidx.compose.ui.platform.LocalContext.current

    val lanzadorCamara = rememberLauncherForActivityResult(
        contract = ActivityResultContracts.TakePicturePreview()
    ) { bitmap -> bitmap?.let { viewModel.registrarFoto(it) } }

    val lanzadorPermiso = rememberLauncherForActivityResult(
        contract = ActivityResultContracts.RequestPermission()
    ) { permisoConcedido ->
        if (permisoConcedido) {
            lanzadorCamara.launch(null)
        }
    }

    Scaffold(
        topBar = {
            CenterAlignedTopAppBar(
                title = {
                    Text(
                        text = if (estado.productoSeleccionado == null) "Lista de Devoluciones" else "Registrar Devolución",
                        style = DevolucionTypography.topBarTitle
                    )
                },
                navigationIcon = {
                    IconButton(onClick = onVolver) {
                        Icon(Icons.Default.ArrowBack, contentDescription = "Volver")
                    }
                },
                colors = TopAppBarDefaults.centerAlignedTopAppBarColors(
                    containerColor = MaterialTheme.colorScheme.surface
                )
            )
        }
    ) { paddingValues ->
        Box(modifier = Modifier
            .fillMaxSize()
            .padding(paddingValues)
            .padding(horizontal = 16.dp)
        ) {
            if (estado.productoSeleccionado == null) {
                Column(modifier = Modifier.fillMaxSize()) {
                    OutlinedTextField(
                        value = "",
                        onValueChange = {},
                        modifier = Modifier
                            .fillMaxWidth()
                            .padding(top = 8.dp, bottom = 8.dp)
                            .height(44.dp),
                        placeholder = {
                            Text("Buscar producto o código CUV", style = TextStyle(fontSize = 13.sp))
                        },
                        leadingIcon = {
                            Icon(Icons.Default.Search, contentDescription = null, modifier = Modifier.size(20.dp))
                        },
                        shape = RoundedCornerShape(12.dp),
                        singleLine = true,
                        colors = TextFieldDefaults.colors(
                            focusedIndicatorColor = Color.Transparent,
                            unfocusedIndicatorColor = Color.Transparent
                        )
                    )

                    var selectedTab by remember { mutableIntStateOf(0) }
                    TabRow(
                        selectedTabIndex = selectedTab,
                        modifier = Modifier.height(44.dp),
                        indicator = { tabPositions ->
                            if (tabPositions.isNotEmpty()) {
                                TabRowDefaults.Indicator(
                                    modifier = Modifier.tabIndicatorOffset(tabPositions[selectedTab]),
                                    height = 2.5.dp
                                )
                            }
                        },
                        divider = {}
                    ) {
                        Tab(
                            selected = selectedTab == 0,
                            onClick = { selectedTab = 0 },
                            text = { Text("Mis Devoluciones", style = DevolucionTypography.secondaryButton) }
                        )
                        Tab(
                            selected = selectedTab == 1,
                            onClick = { selectedTab = 1 },
                            text = { Text("Historial", style = DevolucionTypography.secondaryButton) }
                        )
                    }

                    LazyColumn(
                        verticalArrangement = Arrangement.spacedBy(10.dp),
                        modifier = Modifier.fillMaxSize().padding(vertical = 12.dp)
                    ) {
                        if (selectedTab == 0) {
                            items(estado.productos) { producto ->
                                ProductItemCard(producto) { viewModel.seleccionarProducto(producto) }
                            }
                        } else {
                            item {
                                Text(
                                    "Historial de Devoluciones",
                                    style = DevolucionTypography.sectionTitle,
                                    modifier = Modifier.padding(top = 12.dp, bottom = 8.dp)
                                )
                            }

                            estado.avisoHistorial?.let { aviso ->
                                item {
                                    Text(
                                        aviso,
                                        color = MaterialTheme.colorScheme.error,
                                        style = MaterialTheme.typography.bodySmall,
                                        modifier = Modifier.padding(bottom = 8.dp)
                                    )
                                }
                            }

                            if (estado.cargandoHistorial) {
                                item {
                                    Box(modifier = Modifier.fillMaxWidth(), contentAlignment = Alignment.Center) {
                                        CircularProgressIndicator(modifier = Modifier.size(24.dp))
                                    }
                                }
                            } else if (estado.historial.isEmpty() && estado.avisoHistorial == null) {
                                item {
                                    Text(
                                        "Aún no hay devoluciones registradas",
                                        style = MaterialTheme.typography.bodySmall,
                                        color = MaterialTheme.colorScheme.onSurfaceVariant,
                                        modifier = Modifier.padding(vertical = 16.dp)
                                    )
                                }
                            } else {
                                items(estado.historial) { devolucion ->
                                    HistoryItemCard(devolucion)
                                }
                            }
                        }
                    }
                }
            } else {
                Column(
                    modifier = Modifier.fillMaxSize(),
                    verticalArrangement = Arrangement.spacedBy(16.dp)
                ) {
                    Card(
                        modifier = Modifier.fillMaxWidth(),
                        shape = RoundedCornerShape(14.dp),
                        elevation = CardDefaults.cardElevation(defaultElevation = 3.dp)
                    ) {
                        Row(
                            modifier = Modifier.padding(12.dp),
                            verticalAlignment = Alignment.CenterVertically
                        ) {
                            Box(
                                modifier = Modifier
                                    .size(54.dp)
                                    .clip(RoundedCornerShape(10.dp))
                                    .background(MaterialTheme.colorScheme.surfaceVariant)
                            ) {
                                Icon(
                                    Icons.Default.Inventory,
                                    contentDescription = null,
                                    modifier = Modifier.align(Alignment.Center)
                                )
                            }
                            Spacer(modifier = Modifier.width(12.dp))
                            Column {
                                Text(
                                    "PRODUCTO",
                                    style = TextStyle(
                                        fontSize = 10.sp,
                                        fontWeight = FontWeight.Bold,
                                        letterSpacing = 0.5.sp
                                    ),
                                    color = MaterialTheme.colorScheme.onSurfaceVariant
                                )
                                Text(
                                    estado.productoSeleccionado?.nombre ?: "",
                                    style = DevolucionTypography.productName,
                                    fontSize = 15.sp
                                )
                                Text(
                                    estado.productoSeleccionado?.categoria ?: "",
                                    style = DevolucionTypography.category
                                )
                            }
                        }
                    }

                    if (estado.foto == null) {
                        Column(
                            modifier = Modifier.fillMaxWidth(),
                            horizontalAlignment = Alignment.CenterHorizontally,
                            verticalArrangement = Arrangement.spacedBy(16.dp)
                        ) {
                            Box(
                                modifier = Modifier
                                    .fillMaxWidth()
                                    .height(310.dp)
                                    .drawBehind {
                                        val strokeWidth = 1.5.dp.toPx()
                                        val path = Path().apply {
                                            addRoundRect(
                                                RoundRect(
                                                    RoundRectCornerRadius(16.dp.toPx())
                                                )
                                            )
                                        }
                                        drawPath(
                                            path = path,
                                            color = MaterialTheme.colorScheme.outline,
                                            style = Stroke(
                                                width = strokeWidth,
                                                pathEffect = PathEffect.dashPathEffect(floatArrayOf(6f, 4f), 0f)
                                            )
                                        )
                                    }
                                    .padding(20.dp),
                                contentAlignment = Alignment.Center
                            ) {
                                Column(
                                    horizontalAlignment = Alignment.CenterHorizontally,
                                    verticalArrangement = Arrangement.Center
                                ) {
                                    Text(
                                        "Toma una foto clara donde se vea el envase completo del producto",
                                        style = DevolucionTypography.guideText,
                                        textAlign = TextAlign.Center,
                                        modifier = Modifier.padding(bottom = 24.dp),
                                        lineHeight = 18.sp
                                    )
                                    Icon(
                                        Icons.Default.CameraAlt,
                                        contentDescription = null,
                                        modifier = Modifier.size(64.dp),
                                        tint = MaterialTheme.colorScheme.primary
                                    )
                                    Spacer(modifier = Modifier.height(8.dp))
                                    Text(
                                        "No hay foto registrada",
                                        style = DevolucionTypography.guideSubtext
                                    )
                                }
                            }

                            Button(
                                onClick = {
                                    val tienePermiso = androidx.core.content.ContextCompat.checkSelfPermission(
                                        context,
                                        android.Manifest.permission.CAMERA
                                    ) == android.content.pm.PackageManager.PERMISSION_GRANTED

                                    if (tienePermiso) lanzadorCamara.launch(null)
                                    else lanzadorPermiso.launch(android.Manifest.permission.CAMERA)
                                },
                                modifier = Modifier
                                    .fillMaxWidth()
                                    .height(48.dp),
                                shape = RoundedCornerShape(24.dp),
                                contentPadding = PaddingValues(horizontal = 16.dp)
                            ) {
                                Icon(
                                    Icons.Default.CameraAlt,
                                    contentDescription = null,
                                    modifier = Modifier.size(20.dp)
                                )
                                Spacer(modifier = Modifier.width(8.dp))
                                Text(
                                    "Tomar Foto",
                                    style = DevolucionTypography.mainButton
                                )
                            }
                        }
                    } else {
                        Column(
                            modifier = Modifier.fillMaxWidth(),
                            horizontalAlignment = Alignment.CenterHorizontally,
                            verticalArrangement = Arrangement.spacedBy(12.dp)
                        ) {
                            Image(
                                bitmap = estado.foto!!.asImageBitmap(),
                                contentDescription = "Foto del producto",
                                modifier = Modifier
                                    .fillMaxWidth()
                                    .height(220.dp)
                                    .clip(RoundedCornerShape(16.dp)),
                                contentScale = ContentScale.Crop
                            )

                            Button(
                                onClick = { lanzadorCamara.launch(null) },
                                modifier = Modifier
                                    .width(180.dp)
                                    .height(38.dp),
                                shape = RoundedCornerShape(19.dp),
                                contentPadding = PaddingValues(horizontal = 12.dp)
                            ) {
                                Icon(
                                    Icons.Default.CameraAlt,
                                    contentDescription = null,
                                    modifier = Modifier.size(18.dp)
                                )
                                Spacer(modifier = Modifier.width(8.dp))
                                Text(
                                    "Cambiar Foto",
                                    style = DevolucionTypography.secondaryButton
                                )
                            }

                            estado.resultadoApto?.let { apto ->
                                Card(
                                    modifier = Modifier.fillMaxWidth(),
                                    shape = RoundedCornerShape(16.dp),
                                    border = androidx.compose.foundation.BorderStroke(1.dp, MaterialTheme.colorScheme.outline),
                                    colors = CardDefaults.cardColors(
                                        containerColor = MaterialTheme.colorScheme.surface
                                    )
                                ) {
                                    Column(
                                        modifier = Modifier.padding(14.dp),
                                        horizontalAlignment = Alignment.CenterHorizontally,
                                        verticalArrangement = Arrangement.spacedBy(8.dp)
                                    ) {
                                        Row(
                                            verticalAlignment = Alignment.CenterVertically,
                                            horizontalArrangement = Arrangement.Center
                                        ) {
                                            Icon(
                                                Icons.Default.Warning,
                                                contentDescription = null,
                                                modifier = Modifier.size(18.dp),
                                                tint = if (apto) MaterialTheme.colorScheme.primary else MaterialTheme.colorScheme.error
                                            )
                                            Spacer(modifier = Modifier.width(6.dp))
                                            Text(
                                                text = if (apto) "APTO" else "NO APTO",
                                                style = DevolucionTypography.diagnosisTitle
                                            )
                                        }

                                        Surface(
                                            color = if (apto) MaterialTheme.colorScheme.primaryContainer else MaterialTheme.colorScheme.errorContainer,
                                            shape = RoundedCornerShape(50%)
                                        ) {
                                            Text(
                                                text = if (apto) "Resultado: Producto reconocido correctamente" else "Resultado: No pudimos reconocer el producto",
                                                modifier = Modifier.padding(horizontal = 12.dp, vertical = 4.dp),
                                                style = DevolucionTypography.diagnosisResult
                                            )
                                        }

                                        Text(
                                            text = if (apto)
                                                "El producto coincide con la descripción y está en buen estado."
                                                else "No coincide con ${estado.productoSeleccionado?.nombre}. Por favor, intenta tomar la foto con mejor luz sobre una superficie plana",
                                            style = DevolucionTypography.diagnosisDetail,
                                            textAlign = TextAlign.Center,
                                            lineHeight = 16.sp
                                        )
                                    }
                                }
                            }

                            if (estado.resultadoApto == null) {
                                Button(
                                    onClick = { viewModel.clasificarProducto() },
                                    enabled = !estado.clasificando,
                                    modifier = Modifier.fillMaxWidth().height(48.dp),
                                    shape = RoundedCornerShape(24.dp)
                                ) {
                                    if (estado.clasificando) {
                                        CircularProgressIndicator(
                                            modifier = Modifier.size(20.dp),
                                            color = MaterialTheme.colorScheme.onPrimary
                                        )
                                    } else {
                                        Icon(Icons.Default.AutoAwesome, contentDescription = null, modifier = Modifier.size(20.dp))
                                        Spacer(modifier = Modifier.width(8.dp))
                                        Text("Clasificar con IA", style = DevolucionTypography.mainButton)
                                    }
                                }
                            } else {
                                Button(
                                    onClick = { viewModel.confirmarActualizacionInventario() },
                                    enabled = !estado.actualizando,
                                    modifier = Modifier.fillMaxWidth().height(48.dp),
                                    shape = RoundedCornerShape(24.dp)
                                ) {
                                    if (estado.actualizando) {
                                        CircularProgressIndicator(
                                            modifier = Modifier.size(20.dp),
                                            color = MaterialTheme.colorScheme.onPrimary
                                        )
                                    } else {
                                        Text("Confirmar y Actualizar Inventario", style = DevolucionTypography.mainButton)
                                    }
                                }
                            }
                        }
                    }

                    estado.mensaje?.let { mensaje ->
                        Card(
                            modifier = Modifier.fillMaxWidth(),
                            shape = RoundedCornerShape(14.dp)
                        ) {
                            Column(
                                modifier = Modifier.padding(16.dp),
                                horizontalAlignment = Alignment.CenterHorizontally
                            ) {
                                Text(
                                    mensaje,
                                    color = MaterialTheme.colorScheme.primary,
                                    style = MaterialTheme.typography.bodyMedium,
                                    modifier = Modifier.padding(bottom = 12.dp),
                                    textAlign = TextAlign.Center
                                )
                                OutlinedButton(
                                    onClick = { viewModel.reiniciar() },
                                    modifier = Modifier.fillMaxWidth()
                                ) {
                                    Text("Registrar otra devolución")
                                }
                            }
                        }
                    }

                    estado.error?.let { error ->
                        Text(
                            error,
                            color = MaterialTheme.colorScheme.error,
                            style = MaterialTheme.typography.bodySmall,
                            modifier = Modifier.padding(horizontal = 8.dp),
                            textAlign = TextAlign.Center
                        )
                    }
                }
            }
        }
    }
}

@Composable
fun ProductItemCard(producto: Producto, onClick: () -> Unit) {
    Card(
        modifier = Modifier.fillMaxWidth().clickable { onClick() },
        shape = RoundedCornerShape(14.dp),
        elevation = CardDefaults.cardElevation(defaultElevation = 3.dp)
    ) {
        Row(
            modifier = Modifier.padding(10.dp),
            verticalAlignment = Alignment.CenterVertically
        ) {
            Box(
                modifier = Modifier.size(56.dp).clip(RoundedCornerShape(10.dp)).background(MaterialTheme.colorScheme.surfaceVariant)
            ) {
                Icon(Icons.Default.Inventory, contentDescription = null, modifier = Modifier.align(Alignment.Center))
            }
            Spacer(modifier = Modifier.width(12.dp))
            Column(modifier = Modifier.weight(1f)) {
                Text(producto.nombre, style = DevolucionTypography.productName, maxLines = 1, overflow = TextOverflow.Ellipsis)
                Text(producto.categoria, style = DevolucionTypography.category)
                Text("Cód. ${producto.id} • Campaña 10", style = DevolucionTypography.metadata)
            }
            Button(
                onClick = { },
                modifier = Modifier.height(30.dp).padding(horizontal = 14.dp),
                shape = RoundedCornerShape(50%),
                contentPadding = PaddingValues(horizontal = 12.dp)
            ) {
                Text("Devolver", style = DevolucionTypography.secondaryButton)
            }
        }
    }
}

@Composable
fun HistoryItemCard(devolucion: Devolucion) {
    Card(
        modifier = Modifier.fillMaxWidth(),
        shape = RoundedCornerShape(14.dp),
        elevation = CardDefaults.cardElevation(defaultElevation = 3.dp)
    ) {
        Row(
            modifier = Modifier.padding(10.dp),
            verticalAlignment = Alignment.CenterVertically
        ) {
            Box(
                modifier = Modifier.size(48.dp).clip(RoundedCornerShape(8.dp)).background(MaterialTheme.colorScheme.surfaceVariant)
            ) {
                Icon(Icons.Default.Inventory, contentDescription = null, modifier = Modifier.align(Alignment.Center))
            }
            Spacer(modifier = Modifier.width(12.dp))
            Column(modifier = Modifier.weight(1f)) {
                Text(devolucion.productoNombre, style = DevolucionTypography.productName)
                Text(HoraLima.formatear(devolucion.fecha), style = DevolucionTypography.category)
            }
            Surface(
                color = if (devolucion.apto) MaterialTheme.colorScheme.primaryContainer else MaterialTheme.colorScheme.errorContainer,
                shape = RoundedCornerShape(50%)
            ) {
                Row(
                    modifier = Modifier.padding(horizontal = 10.dp, vertical = 4.dp),
                    verticalAlignment = Alignment.CenterVertically
                ) {
                    Icon(Icons.Default.CheckCircle, contentDescription = null, modifier = Modifier.size(14.dp), tint = MaterialTheme.colorScheme.primary)
                    Spacer(modifier = Modifier.width(4.dp))
                    Text(
                        if (devolucion.apto) "APTO" else "NO APTO",
                        style = TextStyle(fontSize = 11.sp, fontWeight = FontWeight.Bold)
                    )
                }
            }
        }
    }
}
